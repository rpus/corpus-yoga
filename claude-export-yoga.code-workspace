{
	"folders": [
		{
			"name": "claude-export-yoga",
			"path": "."
		}
	],
	"settings": {
		"python.analysis.include": ["src"],
		// mirrors the runtime import roots: shared modules at src/ (sys.path.insert in consumers),
		// src/main/ (the parents[1] insert idiom), and each script's own directory (scripts import
		// siblings directly — python puts the script dir on sys.path; Pylance needs telling)
		"python.analysis.extraPaths": ["src", "src/main", "src/main/browser-captures", "src/main/chat-exports", "src/main/cli", "src/main/code-agents", "src/main/model", "src/test"],
		"python.analysis.typeCheckingMode": "standard",
		"python.defaultInterpreterPath": "${env:HOME}/venvs/general/bin/python", // mirrors the VENV default in run_python_script.sh / RUNME.sh
		"python.analysis.diagnosticMode": "workspace",
		"python.terminal.activateEnvironment": false
	}
}