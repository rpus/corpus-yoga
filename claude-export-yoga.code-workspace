{
	"folders": [
		{
			"name": "claude-export-yoga",
			"path": "."
		}
	],
	"settings": {
		// must name the same interpreter as the VENV default every shell entrypoint sets;
		// held by check_venv_default, which reads them rather than trusting this line
		"python.defaultInterpreterPath": "${env:HOME}/venvs/general/bin/python",
		// The import roots and type-checking mode live in pyrightconfig.json, which
		// Pylance reads INSTEAD of python.analysis.* — so one declaration serves the
		// editor, the pyright CLI, and `yoga test run`. Splitting them is what broke
		// resolution when a partial config once shadowed eight paths with one.
		"python.analysis.diagnosticMode": "workspace",
		"python.terminal.activateEnvironment": false,
		// must match the gate's shellcheck invocation (src/test/dev/run.py passes -x),
		// or the editor emits SC1091 on every `# shellcheck source=` directive that the
		// gate, with the sourced file followed, holds clean. The directives are
		// repo-root-relative, and the extension's cwd is not the repo root, so the
		// root must be named: without --source-path, -x fails to open what it follows
		// and the same SC1091s return as failed follows.
		"shellcheck.customArgs": ["-x", "--source-path=${workspaceFolder}"]
	}
}