{
	"folders": [
		{
			"name": "claude-export-yoga",
			"path": "."
		}
	],
	"settings": {
		"python.analysis.include": ["src"],
		// mirrors the runtime import roots: shared modules at src/ (sys.path.insert in consumers),
		// src/main/ (the parents[1] insert idiom), and each script's own directory (scripts import
		// siblings directly — python puts the script dir on sys.path; Pylance needs telling)
		"python.analysis.extraPaths": ["src", "src/main", "src/main/chat-exports", "src/main/browser-captures", "src/main/model", "src/test"],
		"python.analysis.typeCheckingMode": "standard",
		"python.defaultInterpreterPath": "${env:HOME}/venvs/general/bin/python",
		"python.analysis.diagnosticMode": "workspace" // default from src/activate_venv.sh; override via $VENV
	}
}