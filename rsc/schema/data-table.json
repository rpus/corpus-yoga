{
    "$schema": "https://json-schema.org/draft-04/schema#",
    "title": "a table",
    "description": "about the table",
    "type": "object",
    "required": [
        "columns",
        "rows"
    ],
    "additionalProperties": false,
    "properties": {
        "columns": {
            "description": "about the columns",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "rows": {
            "type": "array",
            "items": {
                "type": "array"
            }
        },
        "note": {
            "type": "string"
        }
    },
    "default": {
        "columns": [
            "key",
            "value"
        ],
        "rows": [
            [
                "",
                null
            ]
        ],
        "note": ""
    }
}