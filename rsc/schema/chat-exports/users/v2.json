{
  "$schema": "https://json-schema.org/draft-04/schema#",
  "title": "users",
  "description": "The details of a single user, from a data export",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "required": [
      "uuid",
      "full_name",
      "email_address",
      "verified_phone_number"
    ],
    "additionalProperties": false,
    "properties": {
      "uuid": {
        "description": "../../model.json#/default/UserUUID",
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "full_name": {
        "description": "LEAKS PRIVACY",
        "type": "string"
      },
      "email_address": {
        "description": "LEAKS PRIVACY",
        "type": "string"
      },
      "verified_phone_number": {
        "description": "LEAKS PRIVACY",
        "type": "string"
      }
    }
  },
  "default": [
    {
      "uuid": "",
      "full_name": "",
      "email_address": "",
      "verified_phone_number": ""
    }
  ]
}
