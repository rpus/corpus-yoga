      "uuid": "",
      "full_name": ""
    },
    "docs": [
      {
        "uuid": "b8b96903-ae49-4fa3-bfd1-3d770e3e2d27",
        "filename": "Claude prompting guide.md",
        "content": "",
        "created_at": "2026-03-23T21:57:54.197738+00:00"
      }
    ]
  }
}
