        {
          "$ref": "#/definitions/jSONReferenceObject"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/documented"
            },
            {
              "$ref": "#/definitions/typeDefinition"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/typeDefinition"
            },
            {
              "title": "bareIntent",
              "description": "a bare type definition",
              "type": "object",
              "properties": {
                "type": {},
                "not": {},
                "allOf": {},
                "anyOf": {},
                "oneOf": {}
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          ]
        },
        {
          "title": "bareExtent",
          "description": "a bare set of allowed values",
          "type": "object",
          "properties": {
            "type": {},
            "enum": {}
          },
          "additionalProperties": false,
          "required": [
            "enum"
          ]
        }
      ]
    },
    "jSONReferenceObject": {
      "title": "jSONReferenceObject",
      "description": "a JSON Reference object",
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string"
        }
      },
      "required": [
        "$ref"
      ]
    },
    "documented": {
      "title": "documented",
      "description": "a constraint that mandates helpful documentary fields",
      "type": "object",
      "default": {
        "title": "",
        "description": ""
      },
      "properties": {
        "title": {
          "type": "string",
          "default": ""
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "default": {}
      },
      "required": [
        "title",
        "description"
      ]
    },
    "typeDefinition": {
      "title": "typeDefinition",
      "description": "a type definition",
      "type": "object",
      "default": {},
      "anyOf": [
        {
          "$ref": "#/definitions/firstOrderTypeDefinition"
        },
        {
          "$ref": "#/definitions/higherOrderTypeDefinition"
        }
      ]
    },
    "firstOrderTypeDefinition": {
      "title": "firstOrderTypeDefinition",
      "description": "a first-order type definition (given by a `type` property)",
      "type": "object",
      "default": {},
      "oneOf": [
        {
          "$ref": "#/definitions/elementaryTypeDefinition"
        },
        {
          "$ref": "#/definitions/shorthandUnionTypeDefinition"
        }
      ]
    },
    "higherOrderTypeDefinition": {
      "title": "higherOrderTypeDefinition",
      "description": "a higher-order type definition (given by `not`, `allOf`, `anyOf` or `oneOf`)",
      "type": "object",
      "default": {},
      "anyOf": [
        {
          "$ref": "#/definitions/complementTypeDefinition"
        },
        {
          "$ref": "#/definitions/intersectionTypeDefinition"
        },
        {
          "$ref": "#/definitions/unionTypeDefinition"
        },
        {
          "$ref": "#/definitions/discriminatedTypeDefinition"
        }
      ]
    },
    "elementaryTypeDefinition": {
      "title": "elementaryTypeDefinition",
