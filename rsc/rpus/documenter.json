          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "type"
      ]
    },
    "complementTypeDefinition": {
      "title": "complementTypeDefinition",
      "description": "a complement-type definition (given by `not`)",
      "type": "object",
      "default": {},
      "properties": {
        "not": {
          "$ref": "#/definitions/definition"
        }
      },
      "required": [
        "not"
      ]
    },
    "intersectionTypeDefinition": {
      "title": "intersectionTypeDefinition",
      "description": "an intersection-type definition (given by `allOf`)",
      "type": "object",
      "default": {},
      "properties": {
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/definition"
          },
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "allOf"
      ]
    },
    "unionTypeDefinition": {
      "title": "unionTypeDefinition",
      "description": "a union-type definition (given by `anyOf`)",
      "type": "object",
      "default": {},
      "properties": {
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/definition"
          },
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "anyOf"
      ]
    },
    "discriminatedTypeDefinition": {
      "title": "discriminatedTypeDefinition",
      "description": "a discriminated-type definition (given by `oneOf`)",
      "type": "object",
      "default": {},
      "properties": {
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/definition"
          },
          "minItems": 1
        }
      },
      "required": [
        "oneOf"
      ]
    },
    "simpleType": {
      "title": "simpleType",
      "description": "one of the simple types",
      "type": "string",
      "default": "",
      "enum": [
        "array",
        "boolean",
        "integer",
        "null",
        "number",
        "object",
        "string"
      ]
    },
    "override_and_rename": {
      "title": "override_and_rename",
      "description": "an example base definition; override and rename this definition",
      "type": "object",
      "default": {
        "an instance of": "`#/definitions/override_and_rename`"
      },
      "properties": {
        "an instance of": {
          "$ref": "#/definitions/delete_when_unused"
        }
      },
      "additionalProperties": false,
      "required": [
        "an instance of"
      ]
    },
    "delete_when_unused": {
      "title": "delete_when_unused",
      "description": "an example nested definition; delete (when unused) this definition",
      "type": "string",
      "default": "`#/definitions/override_and_rename`",
      "enum": [
        "`#/definitions/override_and_rename`"
      ]
    }
  }
}
