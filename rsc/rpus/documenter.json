{
  "$schema": "./documenter.json",
  "oneOf": [
    {
      "$ref": "#/definitions/definition"
    }
  ],
  "title": "documenter",
  "description": "This file (`documenter.json`) is its own Draft-4 JSON Schema, so is: 1. also a documenting wrapper for any example JSON document inlined at `#/default` (to be validated against the schema referenced at `#/properties/default/$ref`), with documentation style constrained by the same `definition` sub-schema it imposes on definitions generally; 2. not an optimal *authoring* tool for Draft-4 schemas. It also functions as a normalising linter, beyond the Draft-4 meta-schema.",
  "type": "object",
  "default": {
    "an instance of": "`#/definitions/override_and_rename`"
  },
  "properties": {
    "$schema": {},
    "oneOf": {},
    "title": {},
    "description": {},
    "type": {},
