    "properties": {},
    "additionalProperties": {},
    "required": {},
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/definition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "$schema",
    "oneOf",
    "properties",
    "additionalProperties",
    "required",
    "definitions"
  ],
  "definitions": {
    "definition": {
      "title": "definition",
      "description": "a `documented` `typeDefinition`",
      "type": "object",
      "default": "[any definition object]",
