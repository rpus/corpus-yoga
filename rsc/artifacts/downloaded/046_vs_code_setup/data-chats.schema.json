{
    "$schema": "https://json-schema.org/draft-04/schema#",
    "description": "One row per conversation: index, display name, and timestamp of last activity.",
    "type": "object",
    "required": ["columns", "rows"],
    "additionalProperties": false,
    "properties": {
        "columns": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 3,
            "maxItems": 3,
            "default": ["chat", "name", "dormant_from"]
        },
        "rows": {
            "type": "array",
            "items": {
                "type": "array",
                "items": [
                    {"description": "chat index (0-based)",          "type": "integer", "minimum": 0},
                    {"description": "conversation display name",      "type": "string"},
                    {"description": "ISO 8601 timestamp of last message", "type": "string"}
                ],
                "minItems": 3,
                "maxItems": 3,
                "additionalItems": false
            }
        }
    },
    "default": {
        "columns": ["chat", "name", "dormant_from"],
        "rows": [[0, "", ""]]
    }
}
