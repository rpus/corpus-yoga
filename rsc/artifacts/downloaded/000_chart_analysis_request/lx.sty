% =============================================================
% lx.sty  —  LaTeX package
%
% LaTeX parallel to lx.tex. Public API is identical where
% possible; divergences from Plain TeX are noted explicitly.
%
% USAGE:
%   \usepackage{lx}          % in preamble
%   \lxSetupPage             % call explicitly after setting flags/dimensions
%
% FLAGS (set in preamble, before \begin{document}):
%   \lxBindingLeft      \lxBindingRight
%   \lxDoubleSided      \lxSingleSided
%   \lxNotesOuter       \lxNotesInner
%
%   NOTE: \lxDoubleSided / \lxSingleSided must agree with the
%   twoside / oneside documentclass option. lx.sty cannot change
%   the documentclass option after the fact — this is a fundamental
%   LaTeX constraint with no equivalent in Plain TeX.
%
% MARGIN WIDTH — two mutually exclusive commands:
%   \lxMarginWidth=3truecm            % absolute (default: 3truecm)
%   \def\lxMarginWidthFraction{0.2}   % relative: fraction of \paperwidth
%
% MARGIN SEP:
%   \lxMarginSep=0.5em  (default)
%
% NOTE FONT:
%   \renewcommand{\lxNoteFont}{\footnotesize}  (default: complete LaTeX 8pt environment)
%   Override with any LaTeX font size command, e.g.: \scriptsize
%   (In Plain TeX: \def\lxNoteFont{\the\scriptfont0 \spacing{7}{10}} — exact)
%
% SIDE / TOP / BOTTOM MARGINS:
%   \lxInnerMargin, \lxOuterMargin, \lxTopMargin, \lxBottomMargin
%   (defaults: 1in each, matching Plain TeX's own defaults)
%
% HEAD / FOOT HOOKS:
%   \lxHeadInner  \lxHeadMiddle  \lxHeadOuter
%   \lxFootInner  \lxFootMiddle  \lxFootOuter
%
%   Defined via \newcommand (LaTeX idiom) rather than \newtoks
%   (Plain TeX idiom) — the only unavoidable API divergence.
%   Set with \renewcommand in your document.
%
%   Defaults reproduce LaTeX's own head/foot defaults:
%     head: all empty (LaTeX's default pagestyle has no running head)
%     foot: \lxFootMiddle=\thepage (centred page number)
%
%   In double-sided mode inner/outer alternate per page via fancyhdr.
%   In single-sided mode inner=left, outer=right throughout.
%
% MARGIN NOTES:
%   \lxMarginNote{NOTE TEXT}
%     Auto-incrementing form (default). Increments \lxNoteNo and
%     uses \lxNoteRef as the reference symbol (default: arabic integer).
%
%   \lxMarginNoteRef{REF}{NOTE TEXT}
%     Explicit-reference form. REF is any user-chosen symbol or string
%     (★, †, $\star$, 42, …); does not increment \lxNoteNo.
%     Allowable REF characters: any token(s) valid as \textsuperscript
%     argument, except unescaped % (comment), # (parameter), or
%     unbalanced braces.
%
%   \lxNoteNo  — counter (analogous to Plain's \pageno)
%   \lxNoteRef — formatter macro; override to change symbol style
%
% PAGE LAYOUT:
%   \lxSetupPage — call once in the preamble, after setting all flags
%   and dimensions. Must be called explicitly, as in Plain TeX.
%   (Earlier versions used \AtBeginDocument — removed as it caused
%   geometry to be committed after LaTeX locked in the page layout.)
% =============================================================

% Guard against double-loading:            % (cf. \ifx\lxLoaded in Plain TeX)
\NeedsTeXFormat{LaTeX2e}                   % (no equivalent in Plain TeX)
\ProvidesPackage{lx}                       % (no equivalent in Plain TeX)
%
\RequirePackage{geometry}                  % (no \RequirePackage in Plain TeX)
                                           % (packages are implicit in plain.tex)
\RequirePackage{fancyhdr}                  % (geometry, fancyhdr etc. not used)
\RequirePackage{ragged2e}
\RequirePackage{ifthen}

% =============================================================
% SPACING UTILITY
%
% In Plain TeX, \spacing{NUM}{DEN} scales all skip parameters by
% NUM/DEN, providing a complete typographic environment switch.
% Used by \lxNoteFont to scale skips alongside the font.
% (In LaTeX, font size commands such as \footnotesize already
% handle this — no \spacing macro is needed or defined here.)
%
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)
%                                          (no \spacing in LaTeX)

% =============================================================
% FLAGS
% =============================================================

\newif\iflxBindingLeft  \lxBindingLefttrue   % default: binding=left
\newif\iflxDoubleSided  \lxDoubleSidedtrue   % default: sides=double
\newif\iflxNotesOuter   \lxNotesOutertrue    % default: notes=outer

\def\lxBindingLeft{\lxBindingLefttrue}
\def\lxBindingRight{\lxBindingLeftfalse}
\def\lxDoubleSided{\lxDoubleSidedtrue}
\def\lxSingleSided{\lxDoubleSidedfalse}
\def\lxNotesOuter{\lxNotesOutertrue}
\def\lxNotesInner{\lxNotesOuterfalse}

% =============================================================
% DIMENSIONS
%
% True units are used for all physical paper geometry.
% TeX's \magnification scales dimensions in pt/cm/mm etc. by the
% magnification ratio; "true" units (truecm, truein etc.) are exempt
% and remain physically fixed — correct for paper geometry.
%
% MARGIN WIDTH — two mutually exclusive user-facing commands:
%   \lxMarginWidth=3truecm          absolute: a true-unit dimension
%   \def\lxMarginWidthFraction{0.2} relative: a bare decimal fraction
%
% If \lxMarginWidthFraction is defined, \lxSetupPage computes
% \lxMarginWidth as that fraction of \paperwidth (set by documentclass).
% (In Plain TeX, engine primitive detected via \ifx...\undefined.)
%
% PAPER SIZE: \paperwidth / \paperheight are set by the documentclass.
% No engine-primitive detection or fallback dimensions are needed here.
% (In Plain TeX: pdfTeX uses \pdfpagewidth/\pdfpageheight; XeTeX uses
% \pagewidth/\pageheight; DVI engines need neither — they use
% \lxPaperWidth/\lxPaperHeight, which default to A4. \lxSetupPage
% detects the available primitive via \ifx...\undefined at call time.
% The user need never mention any engine primitive directly.)
% =============================================================

\newlength{\lxMarginWidth}
\newlength{\lxMarginSep}
\newlength{\lxInnerMargin}
\newlength{\lxOuterMargin}
\newlength{\lxTopMargin}
\newlength{\lxBottomMargin}
%                                          (no \lxPaperWidth  in LaTeX)
%                                          (no \lxPaperHeight in LaTeX)
%                                          (no \lxPageWidth   in LaTeX)
%                                          (no \lxPageHeight  in LaTeX)

% Defaults:
\setlength{\lxMarginWidth}{3truecm}   % used only if \lxMarginWidthFraction not defined
\setlength{\lxMarginSep}{0.5em}
\setlength{\lxInnerMargin}{1truein}
\setlength{\lxOuterMargin}{1truein}
\setlength{\lxTopMargin}{1truein}
\setlength{\lxBottomMargin}{1truein}
%                                          (no \lxPaperWidth  default in LaTeX)
%                                          (no \lxPaperHeight default in LaTeX)

% \lxMarginWidthFraction intentionally NOT defined here by default.

% \lxNoteFont — font/style used for margin note text.
%   Default: \footnotesize — an approximation of Plain TeX's \scriptfont0.
%   (In Plain TeX: \def\lxNoteFont{\the\scriptfont0 } scales automatically
%   with the base font size; exact LaTeX parity is not guaranteed.)
\newcommand{\lxNoteFont}{\footnotesize}

% =============================================================
% PAGE SETUP
%
% Called explicitly in the preamble, after setting all flags and
% dimensions — exactly as in Plain TeX.
%
% Sequence:
%   1. (not needed — \paperwidth/\paperheight set by documentclass)
%      (In Plain TeX, step 1 detects engine and sets \lxPageWidth.)
%   2. If \lxMarginWidthFraction defined, compute \lxMarginWidth.
%      After \lxSetupPage, call \geometry{} directly in document-latex.tex.
%      (In Plain TeX, steps 2+3 are combined inside \lxSetupPage.)
%   3. (not done here — \geometry{} called directly in document-latex.tex)
%      (In Plain TeX, \hsize/\vsize/\hoffset/\voffset set directly.)
%   4. Wire fancyhdr head/foot slots to lx hooks.
%      (In Plain TeX, \headline/\footline assigned directly.)
% =============================================================

\def\lxSetupPage{%
  % --- Step 1: not needed in LaTeX ---   % (cf. engine detection in Plain TeX)
  %
  %
  %
  %
  %
  %
  %
  %
  %
  % --- Step 2: resolve margin width ---
  \ifx\lxMarginWidthFraction\undefined
    % absolute: \lxMarginWidth already set by user (or default)
  \else
    \setlength{\lxMarginWidth}{\lxMarginWidthFraction\paperwidth}%  % (cf. \lxPageWidth)
  \fi
  % --- Step 3: not done here ---         % (cf. direct \hsize etc. in Plain TeX)
  % \geometry{} is called directly in the document preamble after \lxSetupPage,
  % so LaTeX's geometry package processes it at the correct initialisation time.
  % (cf. lx.tex step 3: \hsize, \vsize, \hoffset, \voffset set via \advance)
  % (cf. document-latex.tex: \geometry{top=.., inner=.., marginparwidth=..} etc.)
  % (cf. document-latex.tex: \reversemarginpar if \lxNotesInner is set)
  % (cf. document-latex.tex: bindingoffset if \lxBindingRight is set)
  %
  %
  %
  %
  %
  %
  % --- Step 4: wire fancyhdr ---         % (cf. \headline/\footline in Plain TeX)
  % [LE,RO] = inner (binding side, recto and verso)
  % [RE,LO] = outer (fore-edge, recto and verso)
  % [L]/[R] = left/right in oneside mode
  \pagestyle{fancy}%
  \fancyhf{}%
  \iflxDoubleSided
    \fancyhead[LE,RO]{\lxHeadInner}%  \fancyhead[C]{\lxHeadMiddle}%  \fancyhead[RE,LO]{\lxHeadOuter}%
    \fancyfoot[LE,RO]{\lxFootInner}%  \fancyfoot[C]{\lxFootMiddle}%  \fancyfoot[RE,LO]{\lxFootOuter}%
  \else
    \fancyhead[L]{\lxHeadInner}%      \fancyhead[C]{\lxHeadMiddle}%  \fancyhead[R]{\lxHeadOuter}%
    \fancyfoot[L]{\lxFootInner}%      \fancyfoot[C]{\lxFootMiddle}%  \fancyfoot[R]{\lxFootOuter}%
  \fi
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}
\AtBeginDocument{\pagestyle{fancy}}       % re-assert after article class default
%                                           (no equivalent needed in Plain TeX —
%                                           \headline/\footline are not overridden)
%                                           (then call \geometry{} directly — see
%                                           document-latex.tex for the full sequence)

% =============================================================
% HEAD / FOOT HOOKS
%
% Defined via \newcommand (LaTeX idiom). Override with \renewcommand.
% (In Plain TeX, \newtoks + token register assignment are used instead.)
%
% Defaults reproduce LaTeX's own head/foot defaults:
%   head: all empty (LaTeX's default pagestyle has no running head)
%   foot: \lxFootMiddle=\thepage (centred page number)
%         (Plain TeX default: \lxFootMiddle={\the\pageno})
% =============================================================

\newcommand{\lxHeadInner}{}
\newcommand{\lxHeadMiddle}{}
\newcommand{\lxHeadOuter}{}
\newcommand{\lxFootInner}{}
\newcommand{\lxFootMiddle}{\thepage}
\newcommand{\lxFootOuter}{}
% =============================================================
% BINDING RESOLUTION
%
% In LaTeX, fancyhdr's [LE,RO]/[RE,LO] slot notation handles
% inner/outer alternation automatically per page — no explicit
% resolution macro is needed here.
% (In Plain TeX, \lxResolveBinding + \ifodd\pageno does this work;
% see lx.tex BINDING RESOLUTION for the full implementation.)
%
% fancyhdr slot notation used in \lxSetupPage above:
%   [LE,RO] = inner (binding side, both recto and verso)
%   [RE,LO] = outer (fore-edge,    both recto and verso)
%   [L]/[R] = left/right in oneside mode
%
% Truth table (cf. \lxResolveBinding in lx.tex):
%   double, binding=left,  odd  (recto): inner=left
%   double, binding=left,  even (verso): inner=right
%   double, binding=right, odd  (recto): inner=right
%   double, binding=right, even (verso): inner=left
%   single (any binding):               inner=left always
% =============================================================

%                                          (no \iflxInnerIsLeft   in LaTeX)
%                                          (no \lxResolveBinding  in LaTeX)
% Plain TeX implementation for reference:
%   \newif\iflxInnerIsLeft
%   \def\lxResolveBinding{%
%     \iflxDoubleSided
%       \ifodd\pageno
%         \iflxBindingLeft \lxInnerIsLefttrue \else \lxInnerIsLeftfalse \fi
%       \else
%         \iflxBindingLeft \lxInnerIsLeftfalse \else \lxInnerIsLefttrue \fi
%       \fi
%     \else
%       \lxInnerIsLefttrue
%     \fi
%   }
%                                          (no \lxMakeLine         in LaTeX)
%   \def\lxMakeLine#1#2#3{#1\hfil#2\hfil#3}
%                                          (no \lxResolvedHeadline in LaTeX)
%   \def\lxResolvedHeadline{%
%     \lxResolveBinding
%     \iflxInnerIsLeft
%       \lxMakeLine{\the\lxHeadInner}{\the\lxHeadMiddle}{\the\lxHeadOuter}%
%     \else
%       \lxMakeLine{\the\lxHeadOuter}{\the\lxHeadMiddle}{\the\lxHeadInner}%
%     \fi
%   }
%                                          (no \lxResolvedFootline in LaTeX)
%   \def\lxResolvedFootline{%
%     \lxResolveBinding
%     \iflxInnerIsLeft
%       \lxMakeLine{\the\lxFootInner}{\the\lxFootMiddle}{\the\lxFootOuter}%
%     \else
%       \lxMakeLine{\the\lxFootOuter}{\the\lxFootMiddle}{\the\lxFootInner}%
%     \fi
%   }
%                                          (cf. lx.tex: \headline={\lxResolvedHeadline})
%                                          (cf. lx.tex: \footline={\lxResolvedFootline})

% =============================================================
% MARGIN NOTE COUNTER AND REFERENCE FORMATTER
%
% \lxNoteNo  — LaTeX counter, analogous to Plain's \pageno.
%              Incremented automatically by \lxMarginNote.
%              Access as \thelxNoteNo or \arabic{lxNoteNo}.
%              (In Plain TeX: \newcount\lxNoteNo  \lxNoteNo=0)
%
% \lxNoteRef — formats the counter as the inline/margin symbol.
%              Default: arabic integer.
%              Override e.g.: \renewcommand{\lxNoteRef}{\roman{lxNoteNo}}
%              (In Plain TeX: \def\lxNoteRef{\the\lxNoteNo})
%              (In Plain TeX: \def\lxNoteRef{\romannumeral\lxNoteNo})
% =============================================================

\newcounter{lxNoteNo}                     % (cf. \newcount\lxNoteNo  \lxNoteNo=0)

\newcommand{\lxNoteRef}{\arabic{lxNoteNo}}% (cf. \def\lxNoteRef{\the\lxNoteNo})

% =============================================================
% MARGIN NOTE MACROS
%
% Two clean, unambiguous forms — no optional-argument machinery:
%
%   \lxMarginNote{NOTE}
%     Auto-incrementing form. Increments lxNoteNo then uses
%     \lxNoteRef as the reference symbol.
%     (In Plain TeX, \global\advance\lxNoteNo by 1 replaces
%     \refstepcounter{lxNoteNo}.)
%
%   \lxMarginNoteRef{REF}{NOTE}
%     Explicit-reference form. Uses REF verbatim; does NOT
%     increment lxNoteNo.
%
% Both use \vadjust for placement — exactly parallel to Plain TeX.
% \textwidth is used where Plain TeX uses \hsize; otherwise the
% implementation is identical. No float machinery is involved, so
% there is no "too many unprocessed floats" limit.
% (In Plain TeX, \lxNoteRight/\lxNoteLeft; in LaTeX, \lxstyNoteRight/Left.)
%
% NOTE: as in Plain TeX, \vadjust runs during paragraph building, so
% \pageno is unreliable in double-sided mode. The same known limitation
% applies to both engines. See lx.tex KNOWN LIMITATION for details.
% Single-sided mode (\lxSingleSided) is unaffected in both engines.
% =============================================================

%                                          (no \lxEmitNote in LaTeX)
% In Plain TeX, \lxEmitNote, \lxNoteRight, \lxNoteLeft replace \marginpar:
%   \def\lxEmitNote{\raise.7ex\hbox{\the\scriptfont0 \lxCurrentRef}%
%     \vadjust{\vbox to 0pt{%
%       \vskip-\baselineskip                 % align note top with current line
%       \nointerlineskip                     % suppress interline glue
%       \lxResolveBinding
%       \iflxNotesOuter \iflxInnerIsLeft \lxNoteRight \else \lxNoteLeft \fi
%       \else           \iflxInnerIsLeft \lxNoteLeft  \else \lxNoteRight \fi
%       \fi \vss}}}
%                                          (no \lxNoteRight in LaTeX)
%   \def\lxNoteRight{\hbox{\kern\hsize\kern\lxMarginSep
%     \vbox{\hsize=\lxMarginWidth \lxNoteFont
%       \noindent\hbox{\raise.7ex\hbox{\lxCurrentRef}\thinspace}\lxCurrentNote}}}
%                                          (no \lxNoteLeft  in LaTeX)
%   \def\lxNoteLeft{\hbox{\llap{%
%     \vbox{\hsize=\lxMarginWidth \lxNoteFont
%       \noindent\hbox{\raise.7ex\hbox{\lxCurrentRef}\thinspace}\lxCurrentNote}%
%     \kern\lxMarginSep}}}
%                                          (\marginpar subsumes all three helpers)

\newcommand{\lxMarginNote}[1]{%
  \refstepcounter{lxNoteNo}%              % (cf. \global\advance\lxNoteNo by 1)
  \raise.7ex\hbox{\the\scriptfont0 \lxNoteRef}% % inline mark
  \vadjust{\vbox to 0pt{%                % (cf. \vadjust in Plain TeX)
    \vskip-\baselineskip \nointerlineskip
    \iflxNotesOuter \lxstyNoteRight{\lxNoteRef}{#1}%
    \else           \lxstyNoteLeft{\lxNoteRef}{#1}\fi
    \vss}}%
}

\newcommand{\lxMarginNoteRef}[2]{%
  \raise.7ex\hbox{\the\scriptfont0 #1}%   % inline mark
  \vadjust{\vbox to 0pt{%                % (cf. \vadjust in Plain TeX)
    \vskip-\baselineskip \nointerlineskip
    \iflxNotesOuter \lxstyNoteRight{#1}{#2}%
    \else           \lxstyNoteLeft{#1}{#2}\fi
    \vss}}%
}

\newcommand{\lxstyNoteRight}[2]{\hbox{\kern\textwidth\kern\lxMarginSep
  \vbox{\hsize=\lxMarginWidth \lxNoteFont
    \noindent\hbox{\raise.7ex\hbox{#1}\thinspace}#2}}}

\newcommand{\lxstyNoteLeft}[2]{\hbox{\llap{%
  \vbox{\hsize=\lxMarginWidth \lxNoteFont
    \noindent\hbox{\raise.7ex\hbox{#1}\thinspace}#2}%
  \kern\lxMarginSep}}}

%                                          (no \lxNoteRight/\lxNoteLeft in Plain TeX sense —
%                                          \lxstyNoteRight/Left parallel \lxNoteRight/Left;
%                                          \textwidth used where Plain TeX uses \hsize)

