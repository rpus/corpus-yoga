#!/usr/bin/env bash
# corpus-yoga — the repo's terminal CLI: curated subcommands with zsh tab-completion.
# The table and the machinery share src/main/cli/ — cli.py reads the declarations beside it.
# Bare `corpus-yoga` suggests what to run next and runs none of it; `corpus-yoga -h` is
# the table; `corpus-yoga <command> --help` asks the target itself.
#
# Every python here runs in the venv (#478): the launcher refuses without it,
# naming the mint — src/main/cli/status/status.sh sync --apply,
# the one place the name python3 survives. cli.py stays stdlib-only, so the
# surface never depends on what pip installed; the venv supplies the
# interpreter, never imports.
#
# Every command ends by saying where this checkout stands, and it is said here so that no
# command has to remember it. When each script carried its own line, one script carried it
# and seventeen did not.
#
# It is git's sentence, printed by git: the branch, the lag against the tracking ref and
# its remedy, the dirty paths. A report reads the same refs git reads and can know nothing
# git does not, so anything written here to say the same would be a worse copy of it.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# --no-send, wherever it stands among the words, refuses every send the command and its
# children would make (#703): the one reading of the switch is src/main/send.py, and the
# environment carries it to every process the command runs; the word is taken out here,
# so no command parses it
words=()
for word in "$@"; do
  if [[ "$word" == --no-send ]]; then export CORPUS_YOGA_NO_SEND=1; else words+=("$word"); fi
done
set -- ${words[@]+"${words[@]}"}
: "${CORPUS_YOGA_VENV:=$HOME/venvs/general}"
if [[ -f "$CORPUS_YOGA_VENV/bin/python" ]]; then
  set -- "$SCRIPT_DIR/src/run_python_script.sh" "$SCRIPT_DIR/src/main/cli/cli.py" "$@"
elif [[ "${1-}" == walkthrough ]] && command -v python3 >/dev/null; then
  # the walk needs nothing the venv holds (#766): before the mint it walks the machine report
  shift
  set -- python3 "$SCRIPT_DIR/src/main/cli/walkthrough/walkthrough.py" "$@"
else
  echo "error: venv not found at $CORPUS_YOGA_VENV — pre-venv, the machine report and the mint are ./src/main/cli/status/status.sh [sync --apply], and corpus-yoga walkthrough walks them" >&2
  exit 1
fi

# Nothing sits between the reader and the command it is reading: stdout is the command's
# own, whether a terminal or a program is reading it, and the entrypoint outlives nothing.
# A coda belongs to a verb that MOVED the checkout — forge merge ends with git status for
# that reason — not to every command, most of which change nothing to report on (#324).
exec "$@"
