{
  "schemas": [
    "claude/session",
    "gemini/session",
    "sessionConversation",
    "claude/projectMemory"
  ],
  "input": "data/input/<provider>/code/machine-transport",
  "provider": {
    "claude": {
      "input_glob": "*/*/*.jsonl",
      "extra_input_glob": "*/*/memory/",
      "measure": "prefix",
      "extra_measure": "mirror",
      "unit": "session",
      "families": [
        "claude/session",
        "sessionConversation"
      ],
      "extra_unit": "memory",
      "extra_families": [
        "claude/projectMemory"
      ],
      "companion": "<stem>/"
    },
    "gemini": {
      "input_glob": "*/*/*/.system_generated/logs/transcript*.jsonl",
      "extra_input_glob": "",
      "measure": "prefix",
      "extra_measure": "",
      "unit": "session",
      "families": [
        "gemini/session",
        "sessionConversation"
      ],
      "extra_unit": "",
      "extra_families": [],
      "companion": ""
    }
  },
  "subject_depth": 3,
  "diagnostic_skip": {
    "claude/session": [
      "composition.base_schemas_closed"
    ]
  }
}
