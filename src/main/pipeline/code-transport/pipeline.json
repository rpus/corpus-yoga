{
  "schemas": [
    "claude/session",
    "gemini/session",
    "sessionConversation",
    "claude/projectMemory"
  ],
  "input": "data/input/<provider>/code/machine-transport",
  "provider": {
    "claude": {
      "input_glob": "*/*/*.jsonl",
      "extra_input_glob": "*/*/memory/",
      "measure": "prefix",
      "extra_measure": "mirror",
      "companion": "<stem>/"
    },
    "gemini": {
      "input_glob": "*/*/*/transcript*.jsonl",
      "extra_input_glob": "",
      "measure": "prefix",
      "extra_measure": "",
      "companion": ""
    }
  },
  "subject_depth": 3,
  "diagnostic_skip": {
    "claude/session": [
      "composition.base_schemas_closed"
    ]
  }
}
